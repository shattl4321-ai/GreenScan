# GreenScan — пример конфигурации
# Скопируйте в `.env` и подставьте свои значения.

# --- Vision-провайдер -------------------------------------------------------
# Допустимые значения: openai | gemini | qwen
VISION_PROVIDER=openai

# --- OpenAI (используется при VISION_PROVIDER=openai) -----------------------
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini

# --- Google Gemini (при VISION_PROVIDER=gemini) -----------------------------
GOOGLE_API_KEY=

# --- OpenRouter / Qwen (при VISION_PROVIDER=qwen) ---------------------------
OPENROUTER_API_KEY=
# Default в коде: qwen/qwen-2.5-vl-7b-instruct:free
QWEN_VISION_MODEL=
